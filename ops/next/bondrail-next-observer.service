[Unit]
Description=Bondrail next observer (independent deployment)
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/bondrail-next
EnvironmentFile=/etc/bondrail-next.env
ExecStart=/usr/bin/env node --import tsx scripts/service.ts observer
TimeoutStartSec=600
MemoryMax=700M
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
