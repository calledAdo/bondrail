[Unit]
Description=Bondrail next attester (independent deployment)
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/bondrail-next
EnvironmentFile=/etc/bondrail-next.env
ExecStart=/usr/bin/env node --import tsx scripts/service.ts attester --relay
TimeoutStartSec=600
MemoryMax=700M
