# Install as /etc/bondrail-next.env, mode 0600. Never source a live service environment.
BONDRAIL_DEPLOYMENT=next
BONDRAIL_CHAIN_ID=10143
BONDRAIL_RPC_URL=https://rpc-testnet.monadinfra.com
BONDRAIL_KEY_DIR=/root/.slice
BONDRAIL_KEY_PREFIX=next
# Optionally BONDRAIL_DEPLOYER_KEY_FILE=/operator/shared-deployer.key
BONDRAIL_ENV=testnet
BONDRAIL_STORE=redis
BONDRAIL_STORE_NAMESPACE=bondrail-10143-next
REDIS_REST_URL=https://YOUR-NEXT-REDIS
REDIS_REST_TOKEN=REPLACE
OBSERVER_API_TOKEN=REPLACE-WITH-32-PLUS-RANDOM-CHARACTERS
OBSERVER_REGISTRY=/opt/bondrail-next/.data/deployments/10143-next/registry.json
OBSERVER_HOST=127.0.0.1
OBSERVER_PORT=8790
FACILITATOR_HOST=127.0.0.1
FACILITATOR_PORT=8789
WORKER_TARGETS_FILE=/opt/bondrail-next/.data/deployments/10143-next/targets.json
BONDRAIL_ENABLE_TESTNET_WRITES=1
WORKER_CHECK_TRIGGERS=1
WORKER_MAX_CYCLES=1
WORKER_MAX_GAS_PRICE_WEI=200000000000
INDEXER_URL=https://YOUR-NEXT-ENVIO-ENDPOINT/v1/graphql
ATTESTATION_EVIDENCE_DIR=/opt/bondrail-next/.data/attestations
ATTESTATION_TTL_SECONDS=86400
CRE_BIN=/root/.cre/bin/cre
