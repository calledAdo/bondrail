[Unit]
Description=Bondrail next covenant (independent deployment)
After=network-online.target
Requires=bondrail-next-observer.service
After=bondrail-next-observer.service
[Service]
Type=oneshot
WorkingDirectory=/opt/bondrail-next
EnvironmentFile=/etc/bondrail-next.env
ExecStart=/usr/bin/env node --import tsx scripts/report-next.ts --broadcast
TimeoutStartSec=600
MemoryMax=700M
