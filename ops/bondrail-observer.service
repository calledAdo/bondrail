[Unit]
Description=Bondrail observer
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/opt/bondrail
Environment=HOME=/root
Environment=PATH=/root/.cre/bin:/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/bondrail.env
EnvironmentFile=-/etc/bondrail-observer.env
ExecStart=/usr/bin/env node --import tsx scripts/service.ts observer
TimeoutStartSec=600
MemoryMax=700M
TimeoutStopSec=180
KillMode=mixed
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
