# Install as /etc/bondrail.env, mode 0600. Never source a live service environment.
BONDRAIL_DEPLOYMENT=main
BONDRAIL_CHAIN_ID=10143
BONDRAIL_RPC_URL=https://testnet-rpc.monad.xyz
# Prefer a dedicated provider; plural takes precedence over the single URL above.
# BONDRAIL_RPC_URLS=https://monad-testnet.g.alchemy.com/v2/YOUR_KEY,https://testnet-rpc.monad.xyz
# Shared-IP public-only host: 2 per active process; include CRE and operator commands.
BONDRAIL_RPC_RPS=2
BONDRAIL_RPC_CONCURRENCY=2
BONDRAIL_KEY_DIR=/root/.bondrail
BONDRAIL_KEY_PREFIX=
# Optionally BONDRAIL_DEPLOYER_KEY_FILE=/operator/shared-deployer.key
BONDRAIL_ENV=testnet
BONDRAIL_STORE=redis
BONDRAIL_STORE_NAMESPACE=bondrail-10143-main
REDIS_REST_URL=https://YOUR-REDIS
REDIS_REST_TOKEN=REPLACE
# For migration retain the existing namespace and keys; see MIGRATION-2026-10.md.
OBSERVER_API_TOKEN=REPLACE-WITH-32-PLUS-RANDOM-CHARACTERS
OBSERVER_REGISTRY=/opt/bondrail/.data/deployments/10143-main/registry.json
OBSERVER_HOST=127.0.0.1
OBSERVER_PORT=8790
FACILITATOR_HOST=127.0.0.1
FACILITATOR_PORT=8789
WORKER_TARGETS_FILE=/opt/bondrail/.data/deployments/10143-main/targets.json
BONDRAIL_ENABLE_TESTNET_WRITES=1
WORKER_CHECK_TRIGGERS=1
WORKER_MAX_CYCLES=1
WORKER_MAX_GAS_PRICE_WEI=200000000000
INDEXER_URL=https://indexer.dev.hyperindex.xyz/1ac5720/v1/graphql
ATTESTATION_EVIDENCE_DIR=/opt/bondrail/.data/attestations
ATTESTATION_TTL_SECONDS=86400
CRE_BIN=/root/.cre/bin/cre
# Units set HOME=/root and PATH including /root/.cre/bin and /root/.bun/bin.
# CRE login must already exist at /root/.cre/cre.yaml; never store its contents here.
# Optional service-failure webhook (Slack/Discord JSON); unset logs to journal only.
# ALERT_WEBHOOK_URL=https://<operator-owned-webhook>

# Facilitator gas budget. See docs/deployments/FACILITATOR-GAS.md.
FACILITATOR_GAS_MARGIN_BPS=11500
FACILITATOR_MAX_GAS=500000
FACILITATOR_MAX_FEE_GWEI=150
FACILITATOR_PRIORITY_FEE_GWEI=2
FACILITATOR_STUCK_SECONDS=30
FACILITATOR_LOW_BALANCE_SETTLEMENTS=10
# FACILITATOR_LOW_BALANCE_WEBHOOK_URL=https://<operator-owned-receiver>/gas

# Optional per-service /etc/bondrail-<service>.env loads after this file.
# Preserve existing local-mode overrides; do not replace live files with examples.
