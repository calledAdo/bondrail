# Optional single-host local store. Install as /etc/bondrail-observer.env, mode 0600.
# During migration preserve the existing data directory's contents and identity.
# BONDRAIL_ENV selects storage/HTTP policy, not the chain; chain stays 10143.
BONDRAIL_ENV=local
BONDRAIL_STORE=local
BONDRAIL_DATA_DIR=/opt/bondrail/.data/observer
