[Unit]
Description=Bondrail attester
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/bondrail
EnvironmentFile=/etc/bondrail.env
EnvironmentFile=-/etc/bondrail-attester.env
ExecStart=/usr/bin/env node --import tsx scripts/service.ts attester --relay
TimeoutStartSec=600
MemoryMax=700M
