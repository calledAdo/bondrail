[Unit]
OnFailure=bondrail-alert@%n.service
Description=Bondrail attester
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/bondrail
Environment=HOME=/root
Environment=PATH=/root/.cre/bin:/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/bondrail.env
EnvironmentFile=-/etc/bondrail-attester.env
ExecStart=/usr/bin/env node --import tsx scripts/service.ts attester --relay
TimeoutStartSec=600
MemoryMax=700M
