# Dry-run unless --relay is explicitly passed. Use scripts/service.ts for the current manifest.
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
# BONDRAIL_RPC_URLS (ordered, comma-separated) or BONDRAIL_RPC_URL override RPC_URL.
# BONDRAIL_RPC_RPS=6
# BONDRAIL_RPC_CONCURRENCY=2
INDEXER_URL=http://localhost:8080/v1/graphql
INDEXER_ADMIN_SECRET=
CREDIT_REGISTRY_ADDRESS=
CREDIT_ACCOUNT=
# Optional factory deployment block for bond discovery (default 0).
FACTORY_START_BLOCK=0
ATTESTER_PRIVATE_KEY=
ATTESTATION_TTL_SECONDS=86400
# Optional decimal nonce; otherwise a random uint256 is generated.
ATTESTATION_NONCE=
