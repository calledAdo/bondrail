# Not deployed. Use a factory deployed with the new BondrailAccount implementation.
FACILITATOR_PRIVATE_KEY=0x<gas-only-private-key>
FACILITATOR_FACTORY=0x<new-factory-address>
FACILITATOR_RPC_URL=https://<rpc-for-your-chain>
# BONDRAIL_RPC_URLS takes precedence, then BONDRAIL_RPC_URL, then FACILITATOR_RPC_URL.
# BONDRAIL_RPC_URLS=https://<primary>,https://<fallback>
BONDRAIL_RPC_RPS=6
BONDRAIL_RPC_CONCURRENCY=2
# Durable settlement hash journal; keep across restarts. Separate namespace per deployment.
BONDRAIL_STORE=redis
BONDRAIL_STORE_NAMESPACE=bondrail-facilitator
REDIS_REST_URL=https://<redis-rest-host>
REDIS_REST_TOKEN=
# Chain ID is read once from the RPC at startup; payments must use eip155:<chainId>.
# Default asset is Monad testnet USDC; set this to the token on your chosen chain.
FACILITATOR_ASSET=0x534b2f3A21130d7a60830c2Df862319e593943A3
# Domain is discovered at startup via eip712Domain(), falling back to name()/version().
# Optional overrides take precedence over the discovered name/version:
# FACILITATOR_DOMAIN_NAME=USDC
# FACILITATOR_DOMAIN_VERSION=2
FACILITATOR_HOST=127.0.0.1
FACILITATOR_PORT=8788
# Agent configuration (serve facilitator behind HTTPS outside local development):
# X402_FACILITATOR_URL=https://<facilitator-host>
