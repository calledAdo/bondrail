# Production Monad testnet defaults from docs/deployments/10143.json.
# For local/named deployments generate matching values with scripts/export-env.ts web.
BONDRAIL_DEPLOYMENT=main
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_INDEXER_URL=https://indexer.dev.hyperindex.xyz/1ac5720/v1/graphql
NEXT_PUBLIC_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
NEXT_PUBLIC_FACTORY_ADDRESS=0x94c86517a520e56f104c6c82b96632643b3f5d81
NEXT_PUBLIC_PUMPLAB_BOND_ADDRESS=0xb6f44e47C7468c42A32d9679170cC3C4B145099B
NEXT_PUBLIC_AGENT_BOND_ADDRESS=0x66A9aAfad577A6319645F4E2E2daAad42a987343
# Bondrail credit vault (read-only app view).
NEXT_PUBLIC_VAULT_ADDRESS=0x57fd6a271a6a4e96b151e5d0732c7f61e3059f07
# Portable credit registry.
NEXT_PUBLIC_CREDIT_REGISTRY_ADDRESS=0x8cb78ff328cd4982030f275d017892fd2fa512f8

# Server-side, optional
# Registry storage (Upstash Redis REST); without it profiles and Kuru records live in memory (dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Gas drip for new passkey accounts (testnet MON).
DRIP_PRIVATE_KEY=
DRIP_AMOUNT=0.3
# Nansen payer screening.
NANSEN_API_KEY=

# Local development only: impersonate an address with a mock connector.
# NEXT_PUBLIC_DEV_IMPERSONATE=
