{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@bondrail/sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@bondrail/sdk/*": [
        "./packages/sdk/src/*"
      ]
    }
  }
}
