{
  "name": "@bondrail/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed clients, contract ABIs, x402 payments and credit analytics for Bondrail revenue bonds.",
  "exports": {
    ".": "./src/index.ts",
    "./abis": "./src/abis.ts",
    "./client": "./src/client.ts",
    "./permit": "./src/permit.ts",
    "./x402": "./src/x402.ts",
    "./x402-guard": "./src/x402-guard.ts",
    "./data": "./src/data.ts",
    "./credit": "./src/credit.ts",
    "./yield": "./src/yield.ts",
    "./trigger": "./src/trigger.ts"
  },
  "scripts": {
    "generate": "tsx scripts/generate-abis.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "build": "tsup",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0"
  },
  "devDependencies": {
    "tsup": "8.5.0",
    "@bondrail/observer": "workspace:*",
    "@bondrail/scoring": "workspace:*",
    "viem": "2.54.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calledAdo/bondrail.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/calledAdo/bondrail/tree/next/packages/sdk#readme",
  "keywords": [
    "bondrail",
    "monad",
    "revenue-bonds",
    "x402",
    "viem",
    "ethereum"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "viem": "^2.54.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./abis": {
        "types": "./dist/abis.d.ts",
        "import": "./dist/abis.js",
        "default": "./dist/abis.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js",
        "default": "./dist/client.js"
      },
      "./permit": {
        "types": "./dist/permit.d.ts",
        "import": "./dist/permit.js",
        "default": "./dist/permit.js"
      },
      "./x402": {
        "types": "./dist/x402.d.ts",
        "import": "./dist/x402.js",
        "default": "./dist/x402.js"
      },
      "./x402-guard": {
        "types": "./dist/x402-guard.d.ts",
        "import": "./dist/x402-guard.js",
        "default": "./dist/x402-guard.js"
      },
      "./data": {
        "types": "./dist/data.d.ts",
        "import": "./dist/data.js",
        "default": "./dist/data.js"
      },
      "./credit": {
        "types": "./dist/credit.d.ts",
        "import": "./dist/credit.js",
        "default": "./dist/credit.js"
      },
      "./yield": {
        "types": "./dist/yield.d.ts",
        "import": "./dist/yield.js",
        "default": "./dist/yield.js"
      },
      "./trigger": {
        "types": "./dist/trigger.d.ts",
        "import": "./dist/trigger.js",
        "default": "./dist/trigger.js"
      }
    }
  }
}
