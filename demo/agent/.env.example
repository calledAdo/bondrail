# Server only. Copy to .env.local; never NEXT_PUBLIC_ prefix these values.
BONDRAIL_ENV=local
BONDRAIL_CHAIN_ID=10143
BONDRAIL_STORE=local
BONDRAIL_DATA_DIR=../../.data/agent
# Deployed replicas MUST use shared Redis REST; remove local store settings.
REDIS_REST_URL=
REDIS_REST_TOKEN=
BONDRAIL_STORE_NAMESPACE=bondrail-testnet
AGENT_PUBLIC_URL=http://127.0.0.1:3001
AGENT_INITIAL_PAY_TO=
AGENT_ADMIN_TOKEN=
AGENT_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
# Any OpenAI-compatible chat-completions provider. Defaults to Groq's free tier.
# Kimi: MODEL_BASE_URL=https://api.moonshot.ai/v1 MODEL_ID=kimi-k3
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_ID=openai/gpt-oss-20b
MODEL_API_KEY=
BONDRAIL_RPC_URL=https://testnet-rpc.monad.xyz
