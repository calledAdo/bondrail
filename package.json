{
  "name": "bondrail",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "pnpm --filter @bondrail/web dev",
    "dev:agent": "pnpm --filter @bondrail/demo-agent dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "contracts:test": "forge test --root contracts",
    "contracts:build": "forge build --root contracts",
    "abi": "pnpm --filter @bondrail/sdk generate",
    "readiness": "tsx scripts/readiness.ts",
    "local:deploy": "tsx scripts/deploy-local.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@kuru-labs/kuru-sdk": "^0.0.95",
    "@playwright/test": "1.58.2",
    "@types/node": "22.15.30",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "ethers": "5.8.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "viem": "2.54.2"
  }
}
